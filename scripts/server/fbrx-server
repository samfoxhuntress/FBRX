#!/usr/bin/env bash
# fbrx-server: everyday commands for FBRX Server (FBRX OS for servers, running FBRX Virtual).
set -euo pipefail

DATA=/var/lib/fbrx-virtual
APP=/opt/fbrx-server
ENV_FILE=/etc/fbrx-virtual/fbrx-virtual.env

port() { (grep -E '^FBRX_V_PORT=' "$ENV_FILE" 2>/dev/null || echo FBRX_V_PORT=9443) | tail -1 | cut -d= -f2; }
address() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}'; }
url() { echo "https://$(address || hostname):$(port)"; }
fingerprint() {
  if [ -f "$DATA/tls/virtual.crt" ]; then openssl x509 -in "$DATA/tls/virtual.crt" -noout -fingerprint -sha256 | cut -d= -f2; else echo "not made yet"; fi
}
helper() {
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  "$APP/node/bin/node" --no-warnings "$APP/fbrx-virtual/cli.mjs" "$@"
}
has_ai() { [ -f /etc/systemd/system/fbrx-core.service ]; }
has_gate() { [ -f /etc/systemd/system/fbrx-gate-firewall.service ]; }
roles() { (grep -E '^ROLES=' /etc/fbrx-server-release 2>/dev/null || echo 'ROLES="virtual"') | cut -d'"' -f2; }
need_root() { [ "$(id -u)" -eq 0 ] || { echo "Run this as root (sudo fbrx-server $1)." >&2; exit 1; }; }
has_role() { case ",$(roles)," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

# fbrx-server doctor [--fix] [--quiet]: every service the server's roles need, switched on for the next start and
# running now; with --fix, the ones that are not are switched on and started.
doctor() {
  local fix=0 quiet=0 bad=0 fixed=0
  for a in "$@"; do
    case "$a" in --fix) fix=1 ;; --quiet) quiet=1 ;; *) echo "Unknown option $a (fbrx-server doctor [--fix])" >&2; return 2 ;; esac
  done
  [ "$fix" -eq 0 ] || need_root "doctor --fix"
  line() { if [ "$quiet" -eq 0 ] || [ "$1" != ok ]; then printf '%-5s %-26s %s\n' "$1" "$2" "$3"; fi; }
  # unit, what it is, and "boot" for a one-shot that only has to be switched on (it runs at start-up).
  unit() {
    local u=$1 what=$2 kind=${3:-} en act
    en="$(systemctl is-enabled "$u" 2>/dev/null || true)"
    act="$(systemctl is-active "$u" 2>/dev/null || true)"
    if [ "$en" = "not-found" ] || [ -z "$en" ] && [ "$act" = "inactive" ] && ! systemctl cat "$u" >/dev/null 2>&1; then
      line '!!' "$u" "$what: not installed (run install.sh again with this role)"; bad=$((bad + 1)); return
    fi
    local want_active=1
    [ "$kind" = boot ] && want_active=0
    if [ "$en" = enabled ] || [ "$en" = static ] || [ "$en" = alias ]; then
      if [ "$want_active" -eq 0 ] || [ "$act" = active ]; then line ok "$u" "$what"; return; fi
    fi
    if [ "$fix" -eq 1 ]; then
      [ "$en" = enabled ] || [ "$en" = static ] || systemctl enable "$u" >/dev/null 2>&1 || true
      if [ "$want_active" -eq 1 ] && [ "$act" != active ]; then systemctl restart "$u" >/dev/null 2>&1 || true; fi
      act="$(systemctl is-active "$u" 2>/dev/null || true)"
      en="$(systemctl is-enabled "$u" 2>/dev/null || true)"
      if [ "$en" = enabled ] && { [ "$want_active" -eq 0 ] || [ "$act" = active ]; }; then line fixed "$u" "$what: switched on and running"; fixed=$((fixed + 1)); return; fi
      line '!!' "$u" "$what: still $act (journalctl -u $u says why)"; bad=$((bad + 1)); return
    fi
    local state="$act"
    [ "$want_active" -eq 0 ] && state="loads at start-up"
    [ "$en" = enabled ] || state="$state, off at the next start"
    line '!!' "$u" "$what: $state"; bad=$((bad + 1))
  }

  unit fbrx-virtual.service "the console"
  if has_role virtual; then unit libvirtd.service "the hypervisor (libvirt)"; fi
  if has_role ai; then unit fbrx-core.service "the FBRX core (AI, FBRX Mesh)"; fi
  if has_gate; then
    unit systemd-networkd.service "the gate's ports and VLANs"
    unit dnsmasq.service "DHCP and DNS"
    if [ -f /etc/fbrx-gate/gate.nft ]; then
      unit fbrx-gate-firewall.service "the firewall at start-up" boot
      if nft list table inet fbrx_gate >/dev/null 2>&1; then line ok "firewall" "loaded"
      elif [ "$fix" -eq 1 ] && nft -f /etc/fbrx-gate/gate.nft 2>/dev/null; then line fixed "firewall" "loaded again"; fixed=$((fixed + 1))
      else line '!!' "firewall" "not loaded (sudo fbrx-server doctor --fix)"; bad=$((bad + 1)); fi
    else
      line '!!' "gate" "nothing committed yet: fbrx-server logs says why the first commit waits (then sudo fbrx-gate commit)"; bad=$((bad + 1))
    fi
    if [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)" = 1 ]; then line ok "routing" "on (net.ipv4.ip_forward)"
    elif [ "$fix" -eq 1 ]; then sysctl -qw net.ipv4.ip_forward=1 && line fixed "routing" "switched on"; fixed=$((fixed + 1))
    else line '!!' "routing" "off in the kernel (net.ipv4.ip_forward)"; bad=$((bad + 1)); fi
  fi
  if [ "$(systemctl is-active fbrx-server-firstboot.service 2>/dev/null || true)" = failed ]; then
    line '!!' "first-start setup" "did not finish: the end of /var/log/fbrx-server-install.log says why (sudo bash /opt/fbrx-installer/firstboot.sh)"; bad=$((bad + 1))
  fi
  if has_gate && [ "$(systemctl is-active fbrx-virtual 2>/dev/null || true)" = active ] && [ "$(id -u)" -eq 0 ]; then
    # The gate's own view: the internet side, overlaps with the router in front, settings that fight over the ports.
    local problems
    problems="$(/usr/local/sbin/fbrx-gate status 2>/dev/null | sed -n 's/^problem *//p' || true)"
    while IFS= read -r p; do if [ -n "$p" ]; then line '!!' gate "$p"; bad=$((bad + 1)); fi; done <<<"$problems"
  fi
  if [ "$bad" -eq 0 ]; then
    [ "$quiet" -eq 1 ] && [ "$fixed" -eq 0 ] || echo "Everything FBRX Server needs is on and running."
    return 0
  fi
  [ "$fix" -eq 1 ] || echo "sudo fbrx-server doctor --fix switches on and starts what is off."
  return 1
}

case "${1:-status}" in
  status)
    # shellcheck disable=SC1091
    echo "FBRX Server $(. /etc/fbrx-server-release 2>/dev/null && echo "${VERSION:-}") · powered by FBRX OS"
    echo "Console:      $(url)"
    echo "Roles:        $(roles | sed 's/,/, /g')"
    echo "Service:      $(systemctl is-active fbrx-virtual 2>/dev/null || true)"
    if has_ai; then echo "AI role:      $(systemctl is-active fbrx-core 2>/dev/null || true) (FBRX core: FBRX Mesh on port 47800; Mesh & AI in the console)"; fi
    case ",$(roles)," in *,minidome,*) echo "MiniDome:     watching (findings in the console's MiniDome page)" ;; esac
    if has_gate; then echo "Gate:         firewall $(nft list table inet fbrx_gate >/dev/null 2>&1 && echo loaded || echo 'not loaded yet') · DNS and DHCP $(systemctl is-active dnsmasq 2>/dev/null || true) (fbrx-gate status for more)"; fi
    case ",$(roles)," in
      *,virtual,*)
        echo "Hypervisor:   $(systemctl is-active libvirtd 2>/dev/null || true) (libvirt) · KVM $([ -e /dev/kvm ] && echo on || echo 'off: turn on Virtualization Technology in the BIOS')"
        echo "IOMMU:        $([ -n "$(ls -A /sys/kernel/iommu_groups 2>/dev/null)" ] && echo on || echo 'off (needed to give PCI devices to virtual machines)')"
        ;;
    esac
    echo "Certificate:  $(fingerprint)"
    if [ -s "$DATA/setup-code" ]; then echo "Setup code:   $(cat "$DATA/setup-code")"; fi
    ;;
  doctor) shift; doctor "$@" ;;
  url) url ;;
  fingerprint) fingerprint ;;
  setup-code)
    need_root setup-code
    if [ -s "$DATA/setup-code" ]; then cat "$DATA/setup-code"; else echo "This server is already set up (fbrx-server users lists who can sign in)."; fi
    ;;
  logs)
    shift
    if [ "${1:-}" = "ai" ]; then shift; exec journalctl -u fbrx-core "${@:--n 100}"; fi
    exec journalctl -u fbrx-virtual "${@:--n 100}"
    ;;
  restart)
    need_root restart
    if [ "${2:-}" = "ai" ]; then systemctl restart fbrx-core && echo "The FBRX core restarted"; exit 0; fi
    systemctl restart fbrx-virtual && echo "FBRX Virtual restarted: $(url)"
    ;;
  users) need_root users; helper users ;;
  reset-password) need_root reset-password; shift; helper reset-password "$@" ;;
  create-admin) need_root create-admin; shift; helper create-admin "$@" ;;
  ai)
    need_root ai
    has_ai || { echo "The ai role is not installed (sudo bash install.sh --roles <your roles>,ai)." >&2; exit 1; }
    shift
    helper ai "$@"
    ;;
  help | -h | --help)
    cat <<USAGE
fbrx-server status          what runs, where to open the console, the certificate fingerprint
fbrx-server doctor [--fix]  checks every service this server needs; --fix switches on and starts what is off
fbrx-server url             the console's address
fbrx-server setup-code      the first-time setup code (until someone sets the server up)
fbrx-server logs [-f]       FBRX Virtual's log
fbrx-server logs ai [-f]    the FBRX core's log (the ai role: agent, FBRX Mesh, Mesh Assist)
fbrx-server restart         restart FBRX Virtual (virtual machines keep running)
fbrx-server restart ai      restart the FBRX core (help it was giving or asking for stops)
fbrx-server users           who can sign in
fbrx-server reset-password <user>   a new password for someone locked out
fbrx-server create-admin [name]     another administrator
fbrx-server ai [help]       the AI models on this server: what fits, download, use (ai role)
USAGE
    if has_gate; then echo "fbrx-gate help              FBRX Gate's own commands (networks, firewall, commit, roll back)"; fi
    ;;
  *) echo "Unknown command $1 (fbrx-server help)" >&2; exit 1 ;;
esac
