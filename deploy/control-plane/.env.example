# ---- Required ---------------------------------------------------------------------------------
# Public DNS name pointing at this server. Caddy obtains a TLS certificate for it automatically.
FBRX_DOMAIN=fleet.example.com
ACME_EMAIL=ops@example.com

# First platform administrator (superadmin), created on first start only. Change the password after logging in
# and enable MFA (Account page). Remove these two lines afterwards if you like; they are ignored once users exist.
FBRX_CP_ADMIN_EMAIL=ops@example.com
FBRX_CP_ADMIN_PASSWORD=change-me-to-a-long-passphrase
FBRX_CP_ADMIN_NAME=Platform Admin
FBRX_CP_ORGANIZATION=My Company
# What kind of tenant that first one is: work, school or home (default work). Others are created in FBRX Command.
FBRX_CP_ORGANIZATION_KIND=work

# ---- Keys (optional: generated into the data volume on first start if unset) ------------------
# Supply these from a secrets manager to keep key material out of the volume. Losing them means
# sessions are invalidated (JWT), stored secrets become unreadable (MASTER) and licenses cannot be
# re-issued under the same trust root (LICENSE). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"   # JWT
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # MASTER
#   npm run keys:generate                                                          # LICENSE (Ed25519 PEM)
# FBRX_CP_JWT_SECRET=
# FBRX_CP_MASTER_KEY=
# FBRX_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Tuning -----------------------------------------------------------------------------------
FBRX_CP_SESSION_HOURS=12
FBRX_CP_HEARTBEAT_SECONDS=30
FBRX_CP_SNAPSHOT_RETENTION=10
FBRX_CP_MAX_UPLOAD_MB=4096
FBRX_CP_LOG_LEVEL=info

# ---- FBRX accounts in the cloud (docs/CLOUD.md, docs/ACCOUNTS.md) -----------------------------
# Only for the FBRX Command that runs for everyone: anyone may make an FBRX account and buy editions.
# FBRX_CP_PUBLIC_SIGNUP=1
# The website's account page (Checkout comes back to it; the emailed links open on it) and its origin.
# FBRX_CP_ACCOUNT_URL=https://fbrx.example/account.html
# FBRX_CP_WEBSITE_ORIGINS=https://fbrx.example
# Email from any transactional email service, for confirming addresses and resetting passwords.
# FBRX_SMTP_URL=smtps://user:password@smtp.example.com:465
# FBRX_MAIL_FROM=FBRX <no-reply@fbrx.example>
# Payments: Stripe, the App Store and Google Play (each stays off until its keys are here).
# FBRX_STRIPE_SECRET_KEY=
# FBRX_STRIPE_WEBHOOK_SECRET=
# FBRX_APPLE_BUNDLE_ID=com.fbrx.mobile
# FBRX_APPLE_ROOT_CA=/data/AppleRootCA-G3.cer
# FBRX_GOOGLE_PACKAGE_NAME=com.fbrx.mobile
# FBRX_GOOGLE_SERVICE_ACCOUNT=/data/play-service-account.json
# FBRX_GOOGLE_RTDN_TOKEN=
# FBRX Cloud AI (docs/CLOUD_AI.md): a model provider's OpenAI-compatible address and key (kept here only), and the
# models offered under FBRX's names (name=provider-model, the first the default; *3 counts each token three times).
# FBRX_AI_UPSTREAM_URL=https://api.provider.example/v1
# FBRX_AI_UPSTREAM_KEY=
# FBRX_AI_MODELS=fbrx-everyday=org/model-a,fbrx-thorough=org/model-b*3
